# ---- Environments ----
venv/
.venv/
env/
.env
.env.*

# ---- Python bytecode / caches ----
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- OS noise ----
.DS_Store
Thumbs.db
desktop.ini
*~

# ---- Clinical datasets: NEVER commit anything tabular ----
# No exceptions, not even the synthetic mock. `python data_generator.py`
# regenerates it deterministically in about a second, so there is no reason for a
# spreadsheet to exist in git history — and a blanket rule is the only rule that
# survives someone dropping a real extract into the folder at 5pm on a Friday.
*.xlsx
*.xls
*.xlsm
*.csv
*.tsv
~$*
input_mm_data.xlsx
mock_mm_minutes.xlsx

# ---- Generated pipeline output ----
# Rebuilt by `python engine.py`. Keeping it out of git means no merge conflicts on
# a 3,000-line JSON blob and no stale payload shipped alongside fresh code.
app/data.json

# ---- Generated marketing media ----
# Rebuilt by `python marketing/generate_promo_viz.py`. These are multi-megabyte
# binaries that change wholesale on every render, which git handles badly.
# The post copy and the render script are source and ARE tracked.
marketing/frames/
marketing/visual_preview.gif
marketing/visual_preview.mp4
marketing/*.png
marketing/*.webm

# To keep the whole marketing folder private instead, replace the block above with:
#   marketing/

# ---- Model + build caches ----
.cache/
models/
*.log
